# Frontend (Vite) - variables de entorno
# Copiar a .env:  cp .env.example .env
#
# IMPORTANTE: Vite solo expone al cliente las variables con prefijo VITE_,
# y las inlina en el bundle EN TIEMPO DE BUILD. Para `npm run dev` se leen
# automáticamente desde frontend/.env

# Base del API (gateway/BFF). Si se omite, el frontend usa '/api' (proxy de nginx/vite).
# En produccion (Azure) apunta al Invoke URL del AWS API Gateway.
VITE_API_BASE=/api

# === Microsoft Entra ID (MSAL / OAuth2 - OpenID Connect) ===
# Tenant y App Registration de SmartLogix (PAONARR.onmicrosoft.com).
VITE_AZURE_TENANT_ID=fd3a5752-a5c4-4102-a150-ab53dc03d8e7
VITE_AZURE_CLIENT_ID=e4c4f2ee-ede4-48bb-9d0b-7e6d9e1867eb
# Scope de la API protegida (debe existir en "Expose an API" del App Registration).
VITE_AZURE_API_SCOPE=api://e4c4f2ee-ede4-48bb-9d0b-7e6d9e1867eb/access_as_user
# Redirect URI registrado en Entra (SPA). Si se omite, usa el origen actual.
# Dev: http://localhost:3000  ·  Prod: https://smartlogixfrontduoc.z15.web.core.windows.net
VITE_REDIRECT_URI=http://localhost:3000

# API key de Google Gemini para el AI Hub (optimizador de ruta + chatbot).
# Si se deja vacía, el AI Hub funciona en modo simulado (sin llamadas externas).
VITE_GEMINI_API_KEY=
